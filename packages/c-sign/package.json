    "@stellar/stellar-sdk": "16.3.0",
    "@types/node": "^26.6.3",
    "smart-account-kit": "0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
