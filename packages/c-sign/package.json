{
  "name": "c-sign",
  "version": "0.3.0",
  "description": "Sign and verify messages with Stellar contract accounts (C-Sign)",
  "keywords": [
    "stellar",
    "soroban",
    "smart-account",
    "passkey",
    "sign-in",
    "signature",
    "sep-53"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayweer/c-sign.git",
    "directory": "packages/c-sign"
  },
  "homepage": "https://github.com/sayweer/c-sign#readme",
  "bugs": "https://github.com/sayweer/c-sign/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx e2e/run.ts",
    "vectors": "tsx scripts/vectors.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "test:browser": "tsx scripts/browser-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "sideEffects": false,
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
