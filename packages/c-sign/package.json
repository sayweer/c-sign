{
  "name": "c-sign",
  "version": "0.2.0",
  "description": "Sign and verify messages with Stellar contract accounts (C-Sign)",
  "keywords": [
    "stellar",
    "soroban",
    "smart-account",
    "passkey",
    "sign-in",
    "signature",
    "sep-53"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayweer/c-sign.git",
    "directory": "packages/c-sign"
  },
  "homepage": "https://github.com/sayweer/c-sign#readme",
  "bugs": "https://github.com/sayweer/c-sign/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx e2e/run.ts",
    "e2e:passkey-kit": "tsx e2e/passkey-kit.ts",
    "vectors": "tsx scripts/vectors.ts",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^16.3.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "@types/node": "^26.6.3",
    "passkey-kit": "0.20.0",
    "passkey-kit-014": "npm:passkey-kit@0.14.0",
    "smart-account-kit": "0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "sideEffects": false
}
